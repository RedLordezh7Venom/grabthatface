[Unit]
Description=GrabThatFace Production API Server
After=network.target postgresql.service redis.service qdrant.service
Requires=postgresql.service redis.service qdrant.service

[Service]
Type=notify
User=grabthatface
Group=grabthatface
WorkingDirectory=/opt/grabthatface

# Environment
EnvironmentFile=/opt/grabthatface/.env

# Gunicorn with Uvicorn workers for production
ExecStart=/opt/grabthatface/venv/bin/gunicorn \
    app.main_production:app \
    --workers 4 \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --access-logfile /var/log/grabthatface/api-access.log \
    --error-logfile /var/log/grabthatface/api-error.log \
    --log-level info \
    --pid /var/run/grabthatface/api.pid

# Restart policy
Restart=always
RestartSec=5
StartLimitInterval=0

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/grabthatface/data /var/log/grabthatface /var/run/grabthatface

# Monitoring
WatchdogSec=60

[Install]
WantedBy=multi-user.target
